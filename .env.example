# Copy to .env (gitignored). All backend settings use the SENTINEL_ prefix (backend/app/core/config.py).
# Relative paths are resolved from the repo root.

# Data: the organizer's files, or the synthetic day from `make mock-data`.
SENTINEL_DATA_DIR=data/stage2_mock
# PrecomputedDetector boxes; also the fallback when the live model fails.
SENTINEL_DETECTIONS_FILE=data/stage2_mock/detections.json

# LLM (OpenAI-compatible, e.g. GLM). Leave the key empty to run with the fallback brief.
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=glm-4
SENTINEL_BRIEF_LANGUAGE=tr

# Detector: "precomputed" (JSON above) or "ultralytics" (needs `make install-detector` + weights).
SENTINEL_DETECTOR_KIND=precomputed
SENTINEL_DETECTOR_WEIGHTS=models/best.pt
SENTINEL_DETECTOR_DEVICE=auto
SENTINEL_DETECTOR_IMGSZ=960
SENTINEL_DETECT_CONF_MIN=0.35

# Agent tunables (AGENT_DESIGN §3)
SENTINEL_MATCH_MAX_M=25
SENTINEL_REPORT_RADIUS_M=300
SENTINEL_STOP_SPEED_MS=1.0
SENTINEL_ZONE_RADIUS_M=2000
